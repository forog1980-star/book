import os
import sys
from collections import Counter

try:
    import openpyxl
except ImportError:
    print("ERROR: کتابخانه openpyxl نصب نیست.")
    print("این دستور را اجرا کن:")
    print("python -m pip install openpyxl")
    sys.exit(1)


# ============================================================
# تنظیمات
# ============================================================

EXCEL_FILE = r"ExcelData\martyrs_master_v2.xlsx"

TARGET_NAME = "علی"
TARGET_FAMILY = "حسینزاده مقدم"


# ============================================================
# ابزار
# ============================================================

def clean(value):
    if value is None:
        return ""

    text = str(value).strip()

    text = text.replace("\u200c", " ")
    text = text.replace("ي", "ی")
    text = text.replace("ى", "ی")
    text = text.replace("ك", "ک")

    return " ".join(text.split())


def normalize_number(value):
    text = clean(value)

    text = (
        text.replace("۰", "0")
        .replace("۱", "1")
        .replace("۲", "2")
        .replace("۳", "3")
        .replace("۴", "4")
        .replace("۵", "5")
        .replace("۶", "6")
        .replace("۷", "7")
        .replace("۸", "8")
        .replace("۹", "9")
    )

    # 40.0 -> 40
    try:
        number = float(text)
        if number.is_integer():
            return str(int(number))
    except:
        pass

    return text


def find_column(headers, candidates):
    normalized = {
        clean(h): i
        for i, h in enumerate(headers)
        if clean(h)
    }

    for candidate in candidates:
        candidate = clean(candidate)

        if candidate in normalized:
            return normalized[candidate]

    return None


# ============================================================
# بررسی وجود فایل
# ============================================================

if not os.path.exists(EXCEL_FILE):
    print("ERROR: فایل پیدا نشد:")
    print(os.path.abspath(EXCEL_FILE))
    sys.exit(1)


print("=" * 70)
print("حسابرسی Excel جدید پروژه GolzarStone")
print("=" * 70)

print()
print("فایل:")
print(os.path.abspath(EXCEL_FILE))

print()
print("حجم فایل:")
print(f"{os.path.getsize(EXCEL_FILE):,} bytes")


# ============================================================
# باز کردن Excel
# ============================================================

try:
    wb = openpyxl.load_workbook(
        EXCEL_FILE,
        read_only=True,
        data_only=True
    )
except Exception as e:
    print()
    print("ERROR در باز کردن Excel:")

