import sqlite3
from collections import defaultdict

DB_FILE = "martyrs.db"


def normalize(value):
    """
    برای مقایسه آدرس‌ها:
    مقدار خالی را یکسان می‌کند و اعداد اعشاری مثل 24.0 را به 24 تبدیل می‌کند.
    """
    if value is None:
        return ""

    value = str(value).strip()

    if value.endswith(".0"):
        try:
            value = str(int(float(value)))
        except ValueError:
            pass

    return value


def main():

    connection = sqlite3.connect(DB_FILE)
    cursor = connection.cursor()

    # -----------------------------------------------------
    # اطمینان از وجود جدول QC
    # -----------------------------------------------------

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS qc_reviews (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            qc_code TEXT NOT NULL,
            piece TEXT,
            grave_row TEXT,
            grave_number TEXT,
            record_count INTEGER NOT NULL,
            status TEXT NOT NULL DEFAULT 'نیازمند بررسی',
            result TEXT,
            notes TEXT,
            reviewed_at TEXT
        )
    """)

    # -----------------------------------------------------
    # خواندن اطلاعات مزارها
    # -----------------------------------------------------

    cursor.execute("""
        SELECT
            id,
            piece,
            grave_row,
            grave_number
        FROM martyrs
    """)

    rows = cursor.fetchall()

    print("تعداد کل رکوردهای martyrs:", len(rows))

    # -----------------------------------------------------
    # گروه‌بندی بر اساس آدرس مزار
    # -----------------------------------------------------

    addresses = defaultdict(list)

    for row in rows:

        record_id = row[0]

        piece = normalize(row[1])
        grave_row = normalize(row[2])
        grave_number = normalize(row[3])

        # اگر آدرس کامل نیست، فعلاً وارد QC نمی‌شود
        if not piece or not grave_row or not grave_number:
            continue

        address = (
            piece,
            grave_row,
            grave_number
        )

        addresses[address].append(
            record_id
        )

    # -----------------------------------------------------
    # فقط آدرس‌های دارای بیش از یک رکورد
    # -----------------------------------------------------

    duplicate_addresses = {
        address: record_ids
        for address, record_ids in addresses.items()
        if len(record_ids) > 1
    }

    print(
        "تعداد آدرس‌های تکراری:",
        len(duplicate_addresses)
    )

    # -----------------------------------------------------
    # حذف QCهای قبلی
    #
    # مهم:
    # این کار فقط جدول QC را بازسازی می‌کند.
    # اطلاعات martyrs دست‌نخورده باقی می‌ماند.
    # -----------------------------------------------------

    cursor.execute(
        "DELETE FROM qc_reviews"
    )

