def clean_value(value):
    if value is None or pd.isna(value):
        return ""
    text = str(value).strip()
    if re.fullmatch(r"-?\d+.0+", text):
        try:
            return str(int(float(text)))
        except:
            pass
    return text
def is_checked(value):
    if value is None or pd.isna(value):
        return False
    if isinstance(value, bool):
        return value
    text = str(value).strip().lower()
    return text in {"1", "true", "yes", "بله", "دارد", "✓", "✔", "انجام شده"}
@st.cache_data
def load_data():
    all_data = []
    file_path = EXCEL_FILE if os.path.exists(EXCEL_FILE) else "وضعیت سنگ -.xls"
    if not os.path.exists(file_path):
        return pd.DataFrame()
for sheet in SHEETS:
    try:
        df = pd.read_excel(file_path, sheet_name=sheet, header=1, usecols="B:Q", engine="xlrd")
        if len(df.columns) != len(COLUMN_NAMES):
            continue
        df.columns = COLUMN_NAMES
        for col in COLUMN_NAMES:
            df[col] = df[col].apply(clean_value)
        df = df[df["نام"] != ""]
        df = df[df["نام"] != "جمع"]


        piece_number = sheet.replace("قطعه ", "").strip()
        df.loc[df["قطعه"] == "", "قطعه"] = piece_number


        for col in STATUS_COLUMNS:
            df[col] = df[col].apply(is_checked)
        all_data.append(df)
    except Exception as e:
        pass


if not all_data:
    return pd.DataFrame()


final_df = pd.concat(all_data, ignore_index=True)
