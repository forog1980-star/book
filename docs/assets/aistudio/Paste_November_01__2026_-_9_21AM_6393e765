PS C:\Windows\System32> $jsonFile = "$path\نرم‌افزار کتابخانه\فهرست-کاری-کتابخانه-نسخه-0.1.json"
PS C:\Windows\System32> if (Test-Path $jsonFile) {
>>   Write-Host "`r`n================ SAMPLE JSON: فهرست-کاری-کتابخانه-نسخه-0.1.json ================" -ForegroundColor Cyan
>>   Get-Content $jsonFile -TotalCount 80 -Encoding UTF8 -ErrorAction SilentlyContinue
